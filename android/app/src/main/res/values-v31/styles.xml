<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12+ system splash: the SessionGram mark on the intro's night-blue, then the interactive intro takes over. -->
    <style name="AppTheme" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/intro_bg</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:colorAccent">@color/brand</item>
        <item name="android:windowSplashScreenBackground">@color/intro_bg</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/ic_launcher_fg</item>
        <item name="android:windowSplashScreenIconBackgroundColor">@color/brand</item>
    </style>
</resources>
